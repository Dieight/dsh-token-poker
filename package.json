{
  "name": "dsh-token-poker",
  "version": "0.1.0",
  "description": "Agent 陪玩的虚拟筹码德州扑克（Earn Tokens 风格）——token-poker 的 DeepSeek Harness 移植版",
  "author": "yzxoi (port: dsh)",
  "type": "module",
  "main": "lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "verify:client": "node scripts/verify-client-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "poker",
    "game",
    "entertainment"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dieight/dsh-token-poker.git"
  },
  "homepage": "https://github.com/Dieight/dsh-token-poker",
  "bugs": {
    "url": "https://github.com/Dieight/dsh-token-poker/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.13.0"
}
